menu "MVProbe SWD / Black Magic Debug port"

    config MVPROBE_SWCLK_GPIO
        int "SWCLK GPIO"
        range 0 31
        default 12
        help
            GPIO driving SWCLK. Must be below 32. The default GPIO12 is header pin GP1
            (physical pin 2) on the Waveshare ESP32-S3-Pico, and is also the FSPICLK
            IO_MUX pin, which keeps an SPI-based SWD implementation possible later.

    config MVPROBE_SWDIO_GPIO
        int "SWDIO GPIO"
        range 0 31
        default 11
        help
            GPIO for SWDIO. Must be below 32, because the line direction is switched
            through GPIO_ENABLE_W1TS/W1TC. The default GPIO11 is header pin GP0
            (physical pin 1) on the Waveshare ESP32-S3-Pico, and is also the FSPID
            IO_MUX pin.

    config MVPROBE_NRST_GPIO
        int "Target nRST GPIO (-1 = not connected)"
        range -1 48
        default 14
        help
            Open-drain output with internal pull-up. The default GPIO14 is header pin GP3
            (physical pin 5) on the Waveshare ESP32-S3-Pico. GPIO13 (GP2) is left free
            on purpose: it is the FSPIQ IO_MUX pin.

    config MVPROBE_SWD_FREQ_HZ
        int "Default SWD clock frequency (Hz)"
        range 10000 40000000
        default 4000000
        help
            Requested SWCLK frequency at boot. Can be changed at runtime with
            "monitor frequency". The achievable maximum is limited by the bit-bang loop;
            "monitor swd_info" reports the measured clock.

    config MVPROBE_GDB_PORT
        int "GDB server TCP port"
        range 1 65535
        default 2022

    config MVPROBE_BMD_DEBUG
        bool "Enable Black Magic Debug debug output on the console"
        default n

endmenu

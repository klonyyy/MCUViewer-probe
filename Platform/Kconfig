menu "NETWORK PROBE SWD / Black Magic Debug port"

    config NETWORK_PROBE_SWCLK_GPIO
        int "SWCLK GPIO"
        range 0 31
        default 5
        help
            GPIO driving SWCLK. Must be below 32, because the line is enabled through
            GPIO_ENABLE_W1TS/W1TC.

    config NETWORK_PROBE_SWDIO_GPIO
        int "SWDIO GPIO"
        range 0 31
        default 4
        help
            GPIO for SWDIO. Must be below 32, because the line direction is switched
            through GPIO_ENABLE_W1TS/W1TC.

    config NETWORK_PROBE_NRST_GPIO
        int "Target nRST GPIO (-1 = not connected)"
        range -1 48
        default 10
        help
            Open-drain output with internal pull-up.

    config NETWORK_PROBE_SWD_FREQ_HZ
        int "Default SWD clock frequency (Hz)"
        range 10000 40000000
        default 4000000
        help
            Requested SWCLK frequency at boot. Can be changed at runtime with
            "monitor frequency". The achievable maximum is limited by the bit-bang loop
            and logged at boot.

    config NETWORK_PROBE_GDB_PORT
        int "GDB server TCP port"
        range 1 65535
        default 2022

    config NETWORK_PROBE_BMD_DEBUG
        bool "Enable Black Magic Debug debug output on the console"
        default n

endmenu

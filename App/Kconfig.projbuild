menu "NETWORK PROBE network"

    config NETWORK_PROBE_WIFI_SSID
        string "Default Wi-Fi SSID"
        default ""
        help
            Network to join until one is saved on the setup page; the first one saved replaces it. Leave empty to start
            in setup mode. Put real credentials in sdkconfig.local (git-ignored), not in
            sdkconfig.defaults.

    config NETWORK_PROBE_WIFI_PASSWORD
        string "Default Wi-Fi password"
        default ""

    config NETWORK_PROBE_WIFI_STA_TIMEOUT_MS
        int "Station connect timeout at boot before setup mode (ms)"
        range 1000 120000
        default 15000

    config NETWORK_PROBE_AP_PASSWORD
        string "Setup access point password"
        default ""
        help
            WPA2 password, at least 8 characters. Anything shorter starts an OPEN
            access point. The access point is named after the device id,
            network-probe-xxxxxx.

    config NETWORK_PROBE_AP_CHANNEL
        int "Setup access point channel"
        range 1 13
        default 6
        help
            Once the station joins a network, the access point moves to the channel
            of that network.

    config NETWORK_PROBE_SETUP_BUTTON_GPIO
        int "Setup button GPIO (-1 = none)"
        range -1 48
        default 0
        help
            Active low, with the internal pull-up. Holding it for 3 s while the probe
            runs forgets the saved networks and restarts the probe. The default GPIO0
            is the BOOT button of the Waveshare ESP32-S3-Pico.

    config NETWORK_PROBE_PORT
        int "NETWORK PROBE protocol TCP port (MCUViewer)"
        range 1 65535
        default 2023
        help
            Port of the NETWORK PROBE protocol server. MCUViewer connects here.
            Announced over mDNS as _network-probe._tcp.

    config NETWORK_PROBE_STREAM_BUFFER_KB
        int "Streaming sample buffer (KiB)"
        range 16 1536
        default 1024
        help
            Ring buffer between sampling and the network, in PSRAM. It bridges
            Wi-Fi stalls: at 48 bytes per sample and 3 kHz, 1 MiB holds about 7 s.
            Without PSRAM a 32 KiB buffer in internal RAM is used.

endmenu

menu "NETWORK PROBE SWO"

    config NETWORK_PROBE_SWO_GPIO
        int "SWO GPIO (-1 = no SWO)"
        range -1 48
        default 6
        help
            Input for the target's SWO pin, received in NRZ (UART) encoding by UART1
            with DMA, up to 5 MBaud. UART1 reaches the pin through the GPIO matrix, so
            any free GPIO works. The internal pull-up keeps the line idle while the
            target does not drive it.

    config NETWORK_PROBE_SWO_BUFFER_KB
        int "SWO buffer (KiB)"
        range 16 1024
        default 256
        help
            Buffer between the SWO receiver and the network, in PSRAM, rounded down
            to a power of two. It bridges Wi-Fi stalls: at 2 MBaud (200 kB/s) 256 KiB
            holds about 1.3 s. Without PSRAM a 16 KiB buffer in internal RAM is used.

endmenu

menu "NETWORK PROBE status LED"

    config NETWORK_PROBE_LED_GPIO
        int "Status LED GPIO (-1 = none)"
        range -1 48
        default 21
        help
            Data input of a WS2812 RGB LED, driven by RMT. It shows the network, the
            MCUViewer or GDB session, the traffic and errors. The default GPIO21 is
            the RGB LED of the Waveshare ESP32-S3-Pico.

    config NETWORK_PROBE_LED_BRIGHTNESS
        int "Status LED brightness"
        range 1 255
        default 48
        help
            Full scale of every color. A WS2812 at 255 is glaring on a desk.

    choice NETWORK_PROBE_LED_ORDER
        prompt "Status LED color order"
        default NETWORK_PROBE_LED_ORDER_RGB
        help
            Byte order the LED expects. If red shows as green, pick the other one.

        config NETWORK_PROBE_LED_ORDER_RGB
            bool "RGB (Waveshare ESP32-S3-Pico)"

        config NETWORK_PROBE_LED_ORDER_GRB
            bool "GRB (most WS2812)"

    endchoice

endmenu

# Any ESP32-S3 board with the USB connector on the chip's own USB pins (GPIO19/20)
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_WIFI_TASK_PINNED_TO_CORE_0=y

# The station never joins a network: modem sleep would miss ESP-NOW packets
CONFIG_ESP_WIFI_STA_DISCONNECTED_PM_ENABLE=n

# The USB side: a serial port (CDC-ACM), which every system drives without a driver install
CONFIG_TINYUSB_CDC_ENABLED=y
CONFIG_TINYUSB_CDC_COUNT=1
CONFIG_TINYUSB_CDC_EP_BUFSIZE=8192
CONFIG_TINYUSB_CDC_RX_BUFSIZE=8192
CONFIG_TINYUSB_CDC_TX_BUFSIZE=8192
CONFIG_TINYUSB_DESC_MANUFACTURER_STRING="NETWORK PROBE"
CONFIG_TINYUSB_DESC_PRODUCT_STRING="NETWORK PROBE ESP-NOW dongle"
CONFIG_TINYUSB_DESC_CDC_STRING="NETWORK PROBE ESP-NOW dongle"
# Empty: the chip's MAC address, so a host tells several dongles apart
CONFIG_TINYUSB_DESC_SERIAL_STRING=""

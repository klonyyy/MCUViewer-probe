# Each ESP-IDF project has its own compilation database; the shared components are built by the probe
If:
  PathMatch: (probe|components)/.*
CompileFlags:
  CompilationDatabase: probe/build
---
If:
  PathMatch: Tools/espnow_bench/.*
CompileFlags:
  CompilationDatabase: Tools/espnow_bench/build
---
If:
  PathMatch: Tools/wifi_dongle/.*
CompileFlags:
  CompilationDatabase: Tools/wifi_dongle/build
---
CompileFlags:
  # Xtensa GCC options from the ESP-IDF toolchain that clang doesn't know
  Remove:
    - -mlongcalls
    - -mdisable-hardware-atomics
    - -fstrict-volatile-bitfields
    - -fno-tree-switch-conversion
    - -fzero-init-padding-bits=*
    - -fno-malloc-dce

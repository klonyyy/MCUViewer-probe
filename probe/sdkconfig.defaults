# Targets: Waveshare ESP32-S3-Pico (ESP32-S3R2, 16 MB flash) and ESP32-S3FH4R2 boards (4 MB flash),
# both with 2 MB quad PSRAM. A 4 MB image boots on either; a 16 MB one aborts at boot on 4 MB flash.
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_QUAD=y
CONFIG_SPIRAM_IGNORE_NOTFOUND=y

# CPU and scheduler
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_FREERTOS_HZ=1000

# Core split: Wi-Fi and lwIP on core 0, the SWD owner task on core 1
CONFIG_ESP_WIFI_TASK_PINNED_TO_CORE_0=y
CONFIG_LWIP_TCPIP_TASK_AFFINITY_CPU0=y
# The SWD owner task may busy-wait on core 1 (long flash operations, streaming)
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU1=n

# Wi-Fi throughput over power saving
CONFIG_ESP_WIFI_STA_DISCONNECTED_PM_ENABLE=n

# Streaming: throughput is about the send buffer divided by the RTT, and Wi-Fi RTTs spike
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=32768
# Setup mode adds the DNS and HTTP servers (6 sockets) to the NETWORK PROBE and GDB servers
CONFIG_LWIP_MAX_SOCKETS=16
